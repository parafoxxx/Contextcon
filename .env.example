# Copy to .env and fill in. .env is ignored by git.

# Model that reads news and court records: gemini or anthropic
LLM_PROVIDER=gemini
# Key from https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=

# Crustdata: app.crustdata.com -> API Keys
CRUSTDATA_API_KEY=

# live = real Crustdata (every response cached in data/cache) | replay = cache only (if WiFi fails on stage)
PRAMAAN_MODE=live
