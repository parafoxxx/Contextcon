# Copy to .env and fill in
ANTHROPIC_API_KEY=
CRUSTDATA_API_KEY=

# live = call Crustdata (responses are cached to data/cache and replayed on repeat)
# fixture = use the synthetic dataset in fixtures/ (no network, no credits)
# replay = cache only; fail if a call was never cached (use on stage if WiFi dies)
PRAMAAN_MODE=fixture

# Outbound email. If SMTP_HOST is empty, emails go to data/outbox only (nothing is sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Safety: every outbound email is redirected here during the hackathon demo.
DEMO_INBOX=
